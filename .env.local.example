# Copy to .env.local (local) or add in Vercel > Settings > Environment Variables (production).
ADMIN_EMAIL=admin@ismartdigit.com
ADMIN_PASSWORD=change-me-now
# Long random string, e.g. `openssl rand -hex 32`. Signs the admin session cookie.
AUTH_SECRET=replace-with-a-long-random-string
# Neon Postgres connection string. Leave EMPTY locally to use the ./data JSON file instead.
DATABASE_URL=
